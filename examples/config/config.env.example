# Application Configuration
# Configuration values use SCREAMING_SNAKE_CASE convention

APP_NAME=MyApp
DEBUG_MODE=false
LOG_LEVEL=info

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=production_db

# API Configuration
API_TIMEOUT=30000
API_RETRIES=3

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CACHE=true
